---
import { Button } from 'astro-pure/user'

const { title, skills } = Astro.props
---

<div
  class='grid grid-cols-1 gap-y-2 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-x-5 md:gap-y-0'
>
  <h3 class='whitespace-nowrap font-medium'>{title}</h3>
  <div class='flex min-w-0 flex-row flex-wrap gap-x-4 gap-y-2'>
    {skills.map((skill: string[]) => <Button as='button' title={skill} style='pill' />)}
  </div>
</div>
