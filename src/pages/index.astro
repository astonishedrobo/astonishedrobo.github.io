---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const focus = ['Applied ML', 'Speech & Multilingual AI', 'LLM Systems', 'Computer Vision']
const languagesAndFrameworks = [
  'Python',
  'SQL',
  'PyTorch',
  'TensorFlow',
  'scikit-learn',
  'XGBoost',
  'Hugging Face',
  'LangChain',
  'LangGraph',
  'LlamaIndex'
]
const llmTrainingAndInference = [
  'SFT',
  'DPO',
  'GRPO',
  'LoRA / QLoRA',
  'Quantization',
  'KV caching',
  'vLLM',
  'RAG'
]
const tools = ['FastAPI', 'Docker', 'Git', 'Google Compute Engine', 'Google Cloud Storage']

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='Earth'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Email'
            as='a'
            href='mailto:soumyajit.basu22@gmail.com'
            target='_blank'
          >
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Github'
            as='a'
            href='https://github.com/astonishedrobo'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Hugging Face'
            as='a'
            href='https://huggingface.co/astonishedrobo'
            target='_blank'
          >
            <Icon name='link' class='size-5' slot='icon' />
          </Label>
          <Label
            title='LinkedIn'
            as='a'
            href='https://www.linkedin.com/in/soumyajit-basu/'
            target='_blank'
          >
            <Icon name='link' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      <!-- {/* Get template */}
      <a
        href='mailto:soumyajit.basu22@gmail.com'
        target='_blank'
        class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
      >
        <span class='relative flex items-center justify-center'>
          <span
            class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
          ></span>
          <span class='size-2 rounded-full bg-green-400'></span>
        </span>
        <p class='font-medium text-muted-foreground'>Contact</p>
      </a> -->
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>
          I build and evaluate ML models for large scale social impact. In my free time, I enjoy
          watching documentaries or reading latest LLM papers.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' style='ahead' />
          </Section>
        )
      }

      <Section title='Experience'>
        <Card
          heading='ML Analyst'
          subheading='Wadhwani AI'
          date='August 2025 - Present'
        >
          <ul
            class='space-y-2 text-muted-foreground'
            style='list-style-type: disc; padding-inline-start: 1.5rem;'
          >
            <li>
              Led end-to-end modelling for Rajasthan's statewide Oral Reading Fluency diagnostics
              program, spanning Grades 3 to 8 and reaching approximately 6 million students.
            </li>
            <li>
              Designed the model training and evaluation pipeline, including calibration and
              post-prediction analysis; achieved a 25% to 30% relative macro F1 gain over baseline
              CWPM heuristics.
            </li>
            <li>
              Evaluated ASR models for multi-state pilots and extended an internal model with
              filler-word detection while preserving baseline WER.
            </li>
          </ul>
        </Card>
      </Section>

      <Section title='Open Source'>
        <Card
          as='a'
          heading='Google Research TabFM'
          subheading='Open Source Contributor · Merged PR #62'
          date='July 2026'
          href='https://github.com/google-research/tabfm/pull/62'
        >
          <p class='text-muted-foreground'>
            Implemented ICL context caching for the PyTorch backend, delivering 7.8× higher
            inference throughput with unchanged ROC-AUC. Added INT8 KV-cache quantization, CPU
            offloading, scikit-learn API support, tests, and benchmarks.
          </p>
        </Card>
      </Section>

      <Section title='Publications'>
        <Card
          as='a'
          heading='An Explainable Deep-Clustering Approach to Assess Climate Vulnerability in India'
          subheading='PReMI 2025 · Lecture Notes in Computer Science, Springer'
          date='2026'
          href='https://link.springer.com/chapter/10.1007/978-3-032-18477-1_46'
        />
        <Card
          as='a'
          heading='LLM Driven Legal Text Analytics: A Case Study For Food Safety Violation Cases'
          subheading='AACL-IJCNLP 2025 · JUSTNLP Workshop'
          date='2025'
          href='https://aclanthology.org/2025.justnlp-main.6/'
        />
      </Section>

      <Section title='Education'>
        <Card
          heading='Ashoka University'
          subheading='Postgraduate Diploma in Advanced Studies and Research, Computer Science'
          date='August 2024 - May 2025'
        />
        <Card
          heading='Ashoka University'
          subheading="BS in Computer Science · Dean's List, 3 of 6 semesters"
          date='August 2021 - May 2024'
        />
      </Section>

      <!-- <Section title='Website List'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          <ProjectCard
            href='https://www.youtube.com/watch?v=dQw4w9WgXcQ'
            heading='Lorem ipsum'
            subheading='dolor sit amet, oratio ornatus explicari pro ex'
            imagePath='/src/assets/projects/alex-tyson-2BAXJ7ha74s-unsplash.jpg'
          />
          <ProjectCard
            href='https://www.youtube.com/watch?v=dQw4w9WgXcQ'
