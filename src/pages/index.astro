            href='/projects'
            heading='More projects'
            subheading='Check out more projects'
            imagePath='/src/assets/projects/wen-qiao-g_w8I64FiO0-unsplash.jpg'
          />
        </div>
      </Section> -->

      <Section title='Achievements'>
        <Card
          as='a'
          heading='India Conference at Harvard Policy Hackathon Finalist (2025)'
          subheading='One of 4 teams selected for the Analytics Track (from 401 total teams, 1560 participants) to present at Harvard Kennedy School; developed a data-driven vulnerability index and interactive dashboard to identify and visualize climate change impacts on rural regions'
          href='https://www.linkedin.com/posts/harvard-india-conference_hashtags-policyhackathon2025-indiaconferenceharvard-activity-7289354349804232705-NFgB?utm_source=share&utm_medium=member_desktop'
        />
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Focus Areas' skills={focus} />
        <SkillLayout title='Languages & Frameworks' skills={languagesAndFrameworks} />
        <SkillLayout title='LLM Training & Inference' skills={llmTrainingAndInference} />
        <SkillLayout title='Backend & Tools' skills={tools} />
      </Section>
    </div>
    <!-- <Quote class='mt-12' /> -->
  </main>
</PageLayout>
